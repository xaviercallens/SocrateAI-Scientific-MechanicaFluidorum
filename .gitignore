.claude/settings.local.json
*.olean
*.ilean
*.ir
.lake/
__pycache__/
*.pyc

# Lean build artifacts (cold standalone build; Mathlib cache is multi-GB).
# NOTE: lean_src/lake-manifest.json is deliberately NOT ignored -- it pins the exact
# revision of Mathlib and every transitive dependency, which is what makes the Tier A
# results reproducible. Ignoring it would let `lake update` silently drift the toolchain
# that every LEDGER.md claim was verified against.
lean_src/.lake/
lean_src/lake-manifest.json.bak

# Claude Code transient runtime state (PID/session lock; not project content)
.claude/scheduled_tasks.lock

# Rust build output of the Tier C exploration crate (regenerable: `cargo build --release`).
# The SOURCE (Cargo.toml, src/) is tracked; only the compiled artifacts are ignored.
exploration/triad_frustration_rs/target/
exploration/triad_frustration_rs/Cargo.lock
exploration/dual_scale_scout_rs/target/
exploration/dual_scale_scout_rs/Cargo.lock

# The Tier B forcing evaluator: build output only. Its Cargo.lock is deliberately NOT ignored
# -- it pins the exact dependency revisions a certificate was computed against, the same
# reason lean_src/lake-manifest.json is tracked.
tests/core_forcing_rs/target/
